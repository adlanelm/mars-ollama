#!/usr/bin/env bash
# check-updates: report-only table of pinned vs latest (models, git pins, trellis base, image, torch, Krita plugin, Blender/Unity MCP pins, ACE-Step and SkinTokens code/weights/torch pins). Changes nothing.
# Usage: bin/check-updates        (to update: edit the pin in the file named below, rebuild; see docs/README.md)
# Exit codes: 0 all current, 4 something OUTDATED, 2 network failure (nothing could be checked)
set -uo pipefail
ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd); cd "$ROOT"
T=$(mktemp -d); trap 'rm -rf "${T:?}"' EXIT
TO=${CHECK_TIMEOUT:-25}   # seconds per network call
STABLE='^v?[0-9]+(\.[0-9]+)*$'

# row <slot> <component> <pinned> <latest> <status>; slots order the table
row() { printf '%s\t%s\t%s\t%s\n' "${@:2}" > "$T/$1.row"; }
err() { row "$1" "$2" "${3:--}" "-" error; }
# latest stable tag / HEAD sha of a git url (empty on failure)
newest_tag() { timeout "$TO" git ls-remote --tags --refs "$1" 2>/dev/null | sed 's|.*refs/tags/||' | grep -E "$STABLE" | sort -V | tail -1; }
head_sha() { timeout "$TO" git ls-remote "$1" HEAD 2>/dev/null | cut -c1-40; }
cmp_row() { local s=$1 c=$2 pin=$3 new=$4   # string-equal compare of tags
  [[ -n $new ]] || { err "$s" "$c" "$pin"; return; }
  if [[ $pin == "$new" ]]; then row "$s" "$c" "$pin" "$new" current; else row "$s" "$c" "$pin" "$new" OUTDATED; fi; }
sha_row() { local s=$1 c=$2 pin=$3 h; h=$(head_sha "$4")   # pin may be a short prefix
  [[ -n $h ]] || { err "$s" "$c" "${pin:0:8}"; return; }
  if [[ $h == "$pin"* ]]; then row "$s" "$c" "${pin:0:8}" "${h:0:8}" current; else row "$s" "$c" "${pin:0:8}" "${h:0:8}" OUTDATED; fi; }

check_models() { local n=$1 tool out rc k=0   # one summary row per tool; detail only when outdated
  for tool in llm-pull comfy-pull; do k=$((k+1))
    out=$(timeout 300 "bin/$tool" outdated 2>&1); rc=$?
    case $rc in
      0) row "$n$k" "models: $tool" "all pinned" "-" current;;
      4) local c; c=$(grep -c OUTDATED <<<"$out")
         row "$n$k" "models: $tool" "$c outdated" "-" OUTDATED; grep OUTDATED <<<"$out" | sed 's/^/    /' > "$T/$n$k.detail";;
      *) err "$n$k" "models: $tool" "-"; echo "    $tool: ${out##*$'\n'}" > "$T/$n$k.detail";;
    esac; done; }

check_comfyui() { local n=$1 v url pin name i=0   # ComfyUI release tag + custom-node commits (comfyui/Dockerfile)
  v=$(sed -nE 's/^ARG COMFY_VERSION=(.*)/\1/p' comfyui/Dockerfile)
  cmp_row "${n}0" "comfyui/Dockerfile ComfyUI" "$v" "$(newest_tag https://github.com/Comfy-Org/ComfyUI)"
  while read -r url name pin; do i=$((i+1))
    sha_row "$n$i" "comfyui/Dockerfile $name" "$pin" "$url" &
  done < <(grep -oE 'clone https://[^ ]+ [^ ]+ [0-9a-f]{40}' comfyui/Dockerfile | cut -d' ' -f2-); wait; }

check_trellis() { local n=$1 i=0 pin repo   # NAME_COMMIT=<sha>  # org/repo (trellis/install.sh)
  while read -r pin repo; do i=$((i+1))
    sha_row "$n$i" "trellis/install.sh ${repo##*/}" "$pin" "https://github.com/$repo" &
  done < <(sed -nE 's/^[A-Z0-9_]+_COMMIT=([0-9a-f]{40}) +# +([^ ]+\/[^ ]+).*/\1 \2/p' trellis/install.sh)
  pin=$(sed -nE 's/^ARG TOAST_COMMIT=([0-9a-f]+).*/\1/p' trellis/Dockerfile)
  repo=$(grep -oE 'github(usercontent)?\.com/toastmanAu/[^/]+' trellis/Dockerfile | head -1 | sed 's|.*/toastmanAu/|toastmanAu/|')
  sha_row "${n}9" "trellis/Dockerfile toastmanAu" "$pin" "https://github.com/$repo" &
  trellis_base "${n}8"; wait; }

comfy_tag() { sed -nE 's|^ *image: (comfyui-rocm:.*)|\1|p' docker-compose.yaml | head -1; }   # comfyui-rocm:* tag in compose

trellis_base() { local n=$1 base cur   # informational: trellis FROM tag vs the comfyui tag in compose; behind is fine, missing is not
  base=$(sed -nE 's/^ARG COMFY_BASE=(.*)/\1/p' trellis/Dockerfile)
  cur=$(comfy_tag)
  if ! docker image inspect "$base" >/dev/null 2>&1; then row "$n" "trellis base (trellis/Dockerfile)" "$base" "$cur" "missing base"
  elif [[ $base == "$cur" ]]; then row "$n" "trellis base (trellis/Dockerfile)" "$base" "$cur" current
  else row "$n" "trellis base (trellis/Dockerfile)" "$base" "$cur" "behind (ok)"; fi; }

check_colibri() { local n=$1 tag url   # colibri/build.sh: git clone --branch <tag> <url>
  read -r tag url < <(sed -nE 's/.*git clone .*--branch ([^ ]+) (https:[^ ]+).*/\1 \2/p' colibri/build.sh)
  cmp_row "$n" "colibri/build.sh" "$tag" "$(newest_tag "$url")"; }

check_image() { local n=$1 tag new   # compose tag vNNN-vulkan-bNNNNN; the vNNN part decides
  tag=$(sed -nE 's|^ *image: ghcr.io/mostlygeek/llama-swap:(v[0-9]+-vulkan-.*)|\1|p' docker-compose.yaml | head -1)
  new=$(newest_tag https://github.com/mostlygeek/llama-swap)
  [[ -n $new ]] || { err "$n" "docker-compose.yaml llama-swap" "$tag"; return; }
  if [[ ${tag%%-*} == "$new" ]]; then row "$n" "docker-compose.yaml llama-swap" "$tag" "$new-vulkan-*" current
  else row "$n" "docker-compose.yaml llama-swap" "$tag" "$new-vulkan-*" OUTDATED; fi; }

check_torch() { local n=$1 img have new idx   # image's torch (+rocm local tag) vs download.pytorch.org
  img=$(comfy_tag)
  have=$(docker run --rm --entrypoint pip "$img" show torch 2>/dev/null | sed -nE 's/^Version: (.*)/\1/p')
  [[ -n $have ]] || { err "$n" "torch in $img"; return; }
  idx=${TORCH_INDEX:-https://download.pytorch.org/whl/rocm7.2/torch/}
  new=$(timeout "$TO" curl -sfL "$idx" | grep -oE 'torch-[0-9]+\.[0-9]+\.[0-9]+(%2B|\+)rocm[0-9.]+-' | sed -E 's/^torch-//; s/%2B/+/; s/-$//' | sort -uV | tail -1)
  [[ -n $new ]] || { err "$n" "torch in $img" "$have"; return; }
  cmp_row "$n" "torch in $img" "$have" "$new"; }

check_krita() { local n=$1 v   # docs/krita.md first **vX.Y.Z**
  v=$(grep -oE '\*\*v[0-9]+\.[0-9]+\.[0-9]+\*\*' docs/krita.md | head -1 | tr -d '*')
  cmp_row "$n" "docs/krita.md Krita plugin" "$v" "$(newest_tag https://github.com/Acly/krita-ai-diffusion)"; }

check_blender_mcp() { local n=$1 f pin   # SHA= in gamekit tools/mcp/blender-mcp.sh (GAMEKIT overrides the repo path)
  f=${GAMEKIT:-$HOME/devel/gamekit}/tools/mcp/blender-mcp.sh
  pin=$(sed -nE 's/^SHA=([0-9a-f]{40}).*/\1/p' "$f" 2>/dev/null)
  [[ -n $pin ]] || { err "$n" "gamekit blender-mcp.sh"; return; }
  sha_row "$n" "gamekit blender-mcp.sh" "$pin" https://github.com/ahujasid/blender-mcp; }

check_unity_mcp() { local n=$1 f pin u=https://github.com/CoplayDev/unity-mcp tag h   # SHA= in gamekit tools/mcp/unity-mcp.sh; pinned to a release tag (HEAD is beta)
  f=${GAMEKIT:-$HOME/devel/gamekit}/tools/mcp/unity-mcp.sh
  pin=$(sed -nE 's/^SHA=([0-9a-f]{40}).*/\1/p' "$f" 2>/dev/null)
  [[ -n $pin ]] || { err "$n" "gamekit unity-mcp.sh"; return; }
  tag=$(newest_tag "$u"); [[ -n $tag ]] && h=$(timeout "$TO" git ls-remote "$u" "refs/tags/$tag" "refs/tags/$tag^{}" 2>/dev/null | tail -1 | cut -c1-40)
  [[ -n ${h:-} ]] || { err "$n" "gamekit unity-mcp.sh" "${pin:0:8}"; return; }
  if [[ $h == "$pin" ]]; then row "$n" "gamekit unity-mcp.sh" "${pin:0:8}" "$tag ${h:0:8}" current; else row "$n" "gamekit unity-mcp.sh" "${pin:0:8}" "$tag ${h:0:8}" OUTDATED; fi; }

# whl_row <slot> <component> <pinned version> <package>: newest <package> on the rocm7.2 index (same index as check_torch)
whl_row() { local n=$1 c=$2 pin=$3 pkg=$4 new idx=${TORCH_INDEX:-https://download.pytorch.org/whl/rocm7.2/torch/}
  new=$(timeout "$TO" curl -sfL "${idx%torch/}$pkg/" | grep -oE "$pkg-[0-9]+\.[0-9]+\.[0-9]+(%2B|\+)rocm" | sed -E "s/^$pkg-//; s/(%2B|\+)rocm$//" | sort -uV | tail -1)
  [[ -n $new ]] && cmp_row "$n" "$c" "$pin" "$new" || err "$n" "$c" "$pin"; }
# hf_row <slot> <component> <pinned sha> <org/repo>: HF main head vs pinned revision (HF API, no token)
hf_row() { local n=$1 c=$2 pin=$3 h
  h=$(timeout "$TO" curl -sfL "https://huggingface.co/api/models/$4" | jq -r '.sha // empty' 2>/dev/null)
  [[ -n $h ]] || { err "$n" "$c" "${pin:0:8}"; return; }
  if [[ $h == "$pin" ]]; then row "$n" "$c" "${pin:0:8}" "${h:0:8}" current; else row "$n" "$c" "${pin:0:8}" "${h:0:8}" OUTDATED; fi; }

check_acestep() { local n=$1 pin tv ta   # ARG ACESTEP_COMMIT / TORCH / TORCHAUDIO (acestep/Dockerfile), REV= (acestep/fetch-weights.sh)
  pin=$(sed -nE 's/^ARG ACESTEP_COMMIT=([0-9a-f]{40}).*/\1/p' acestep/Dockerfile)
  sha_row "${n}1" "acestep/Dockerfile ACE-Step-1.5" "$pin" https://github.com/ace-step/ACE-Step-1.5 &
  hf_row "${n}2" "acestep/fetch-weights.sh Ace-Step1.5" "$(sed -nE 's/^REV=([0-9a-f]{40}).*/\1/p' acestep/fetch-weights.sh)" ACE-Step/Ace-Step1.5 &
  # torch is held at torchaudio's last rocm7.2 version (2.11.0), so torchaudio is the one that can move
  ta=$(sed -nE 's/^ARG .*TORCHAUDIO=([0-9.]+).*/\1/p' acestep/Dockerfile)
  whl_row "${n}3" "acestep/Dockerfile torchaudio" "$ta" torchaudio &
  wait; }

check_skintokens() { local n=$1 pin base j pr merged h   # PR #14 head + its upstream base (skintokens/Dockerfile), weights revisions (skintokens/fetch-weights.sh)
  pin=$(sed -nE 's/^ARG SKINTOKENS_COMMIT=([0-9a-f]{40}).*/\1/p' skintokens/Dockerfile)
  base=$(sed -nE 's/^# PR14_BASE=([0-9a-f]{40}).*/\1/p' skintokens/Dockerfile)
  local u=https://github.com/VAST-AI-Research/SkinTokens
  h=$(timeout "$TO" git ls-remote "$u" refs/pull/14/head 2>/dev/null | cut -c1-40)
  j=$(timeout "$TO" curl -sfL https://api.github.com/repos/VAST-AI-Research/SkinTokens/pulls/14 | jq -r '"\(.state) \(.merged)"' 2>/dev/null)
  if [[ -z $h || -z $j ]]; then err "${n}1" "skintokens/Dockerfile PR #14 head" "${pin:0:8}"
  elif [[ $j == *true ]]; then row "${n}1" "skintokens/Dockerfile PR #14 head" "${pin:0:8}" "merged upstream" OUTDATED
  elif [[ $j == closed* ]]; then row "${n}1" "skintokens/Dockerfile PR #14 head" "${pin:0:8}" "closed unmerged" OUTDATED
  elif [[ $h == "$pin" ]]; then row "${n}1" "skintokens/Dockerfile PR #14 head" "${pin:0:8}" "${h:0:8} (open)" current
  else row "${n}1" "skintokens/Dockerfile PR #14 head" "${pin:0:8}" "${h:0:8} (open)" OUTDATED; fi
  sha_row "${n}2" "skintokens/Dockerfile upstream main (PR base)" "$base" "$u" &
  hf_row "${n}3" "skintokens/fetch-weights.sh SkinTokens" "$(sed -nE "s/.*hf_hub_download\('VAST-AI\/SkinTokens', f, revision='([0-9a-f]{40})'.*/\1/p" skintokens/fetch-weights.sh)" VAST-AI/SkinTokens &
  hf_row "${n}4" "skintokens/fetch-weights.sh Qwen3-0.6B" "$(sed -nE "s/.*snapshot_download\('Qwen\/Qwen3-0.6B', revision='([0-9a-f]{40})'.*/\1/p" skintokens/fetch-weights.sh)" Qwen/Qwen3-0.6B &
  whl_row "${n}5" "skintokens/Dockerfile torch" "$(sed -nE 's/^ARG TORCH=([0-9.]+).*/\1/p' skintokens/Dockerfile)" torch &
  wait; }

check_models 1 & check_comfyui 2 & check_trellis 3 & check_colibri 4 & check_image 5 & check_torch 6 & check_krita 7 & check_blender_mcp 8 & check_unity_mcp 9 & check_acestep a & check_skintokens b & wait

{ printf 'component\tpinned\tlatest\tstatus\n'; cat "$T"/*.row 2>/dev/null; } | column -t -s $'\t'
for f in "$T"/*.detail; do [[ -f $f ]] && cat "$f"; done
rows=$(cat "$T"/*.row 2>/dev/null | wc -l); errs=$(cat "$T"/*.row 2>/dev/null | grep -cE $'\t(error|missing base)$')
if grep -q $'\tOUTDATED$' "$T"/*.row 2>/dev/null; then exit 4; fi
[[ $errs -lt $rows ]] || exit 2
[[ $errs == 0 ]] || echo "check-updates: $errs check(s) failed (see 'error' rows)" >&2
exit 0
