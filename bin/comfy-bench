#!/usr/bin/env python3
"""comfy-bench: time API-format workflows (comfyui/workflows/*.json) against a running ComfyUI. stdlib only.
usage: comfy-bench [workflow ...]   (default: all). Run 1 = warm-up (model load), runs 2..N timed; peak VRAM sampled from sysfs."""
import json, pathlib, sys, threading, time, urllib.request, os
URL = os.environ.get("COMFY_URL", "http://localhost:8188"); RUNS = int(os.environ.get("RUNS", "3"))
VRAM = os.environ.get("GPU_CARD", "/sys/class/drm/card1/device") + "/mem_info_vram_used"
WF = pathlib.Path(__file__).resolve().parent.parent / "comfyui" / "workflows"
def call(p, data=None):
    req = urllib.request.Request(URL + p, json.dumps(data).encode() if data is not None else None, {"Content-Type": "application/json"})
    return json.load(urllib.request.urlopen(req))
def vram(): return int(open(VRAM).read()) / 2**20
peak = 0.0; stop = False
def sampler():
    global peak
    while not stop: peak = max(peak, vram()); time.sleep(0.2)
def run(g, seed):
    for n in g.values():
        for k in ("seed", "noise_seed"):
            if k in n["inputs"]: n["inputs"][k] = seed
    t = time.time(); pid = call("/prompt", {"prompt": g})["prompt_id"]
    while True:
        h = call(f"/history/{pid}")
        if pid in h:
            st = h[pid]["status"]
            if st["status_str"] != "success": sys.exit(f"failed: {json.dumps(st)[:800]}")
            return time.time() - t
        time.sleep(0.25)
threading.Thread(target=sampler, daemon=True).start()
names = sys.argv[1:] or sorted(p.stem for p in WF.glob("*.json"))
for name in names:
    g = json.loads((WF / f"{name}.json").read_text()); peak = 0.0; ts = []
    for i in range(RUNS): ts.append(run(g, 1000 + i))
    print(f"{name}: warmup {ts[0]:.1f}s  timed {', '.join(f'{x:.1f}' for x in ts[1:])}s  peak VRAM {peak:.0f} MiB", flush=True)
stop = True
