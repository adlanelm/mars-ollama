#!/usr/bin/env bash
# pi-setup: install mars's general pi config (pi/) into the pi agent dir.
# models.json, extensions/, agents/, prompts/ are symlinked (repo edits apply live);
# settings.json is copied because pi writes to it (lastChangelogVersion). Re-run after editing it.
# Project-specific additions go in <project>/.pi/settings.json (e.g. gamekit's game template).
set -euo pipefail
SRC=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../pi" && pwd)
PI_DIR=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}
mkdir -p "$PI_DIR"

backup() { [[ -e $1 && ! -L $1 ]] && mv "$1" "$1.bak.$(date +%Y%m%d-%H%M%S)" && echo "backed up $1"; return 0; }
# copy variant for settings.json (installed, not symlinked): a timestamped copy of $1 unless it equals $2.
# An if, not &&, so a failing cp stops the script (set -e).
backup_copy() {
  if [[ -f $1 && ! -L $1 ]] && ! cmp -s "$1" "$2"; then
    cp "$1" "$1.bak.$(date +%Y%m%d-%H%M%S)"
    echo "backed up $1"
  fi
}

for f in models.json extensions agents prompts; do
  backup "$PI_DIR/$f"
  ln -sfn "$SRC/$f" "$PI_DIR/$f"
done
backup_copy "$PI_DIR/settings.json" "$SRC/settings.json"
install -m 600 "$SRC/settings.json" "$PI_DIR/settings.json"
echo "installed pi config from $SRC into $PI_DIR"
