{
  "1": {"class_type": "Trellis2LoadModel_GGUF", "_meta": {"title": "load model"},
        "inputs": {"modelname": "TRELLIS.2-4B", "model_format": "GGUF Q8_0", "backend": "sdpa", "device": "cuda",
                   "low_vram": true, "keep_models_loaded": false}},
  "2": {"class_type": "Trellis2LoadImageWithTransparency_GGUF", "_meta": {"title": "load image"},
        "inputs": {"image": "prop-terminal_05_1234.png"}},
  "3": {"class_type": "Trellis2PreProcessImage_GGUF", "_meta": {"title": "rembg + crop"},
        "inputs": {"image": ["2", 2], "padding": 0, "remove_background": true}},
  "4": {"class_type": "Trellis2MeshWithVoxelGenerator_GGUF", "_meta": {"title": "generate (sparse, shape, texture)"},
        "inputs": {"pipeline": ["1", 0], "image": ["3", 0], "seed": 1234, "pipeline_type": "512",
                   "sparse_structure_steps": 12, "shape_steps": 12, "texture_steps": 12, "max_num_tokens": 49152,
                   "sparse_structure_resolution": 32, "max_views": 4, "generate_texture_slat": true,
                   "use_tiled_decoder": true, "sampler": "euler"}},
  "5": {"class_type": "Trellis2PostProcessAndUnWrapAndRasterizer_GGUF", "_meta": {"title": "remesh, UV unwrap, bake"},
        "inputs": {"mesh": ["4", 0], "bvh": ["4", 1],
                   "mesh_cluster_threshold_cone_half_angle_rad": 60.0, "mesh_cluster_refine_iterations": 0,
                   "mesh_cluster_global_iterations": 1, "mesh_cluster_smooth_strength": 1,
                   "texture_size": 2048, "remesh": true, "remesh_band": 1.0, "remesh_project": 0.0,
                   "target_face_num": 200000, "simplify_method": "Cumesh", "fill_holes": true,
                   "texture_alpha_mode": "OPAQUE", "dual_contouring_resolution": "512",
                   "double_side_material": false, "remove_floaters": true, "bake_on_vertices": false,
                   "use_custom_normals": false, "uv_unwrap_method": "Xatlas", "remove_inner_faces": true}},
  "6": {"class_type": "Trellis2ExportMesh_GGUF", "_meta": {"title": "export glb"},
        "inputs": {"trimesh": ["5", 0], "filename_prefix": "trellis2/prop-terminal", "file_format": "glb"}}
}
